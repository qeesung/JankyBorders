#!/bin/bash

set -euo pipefail

JB_SERVICE_LABEL="io.github.qeesung.jankyborders.local"
JB_ARTIFACT_SCHEMA="app-v2"
JB_LEGACY_ARTIFACT_SCHEMA="service-v1"
JB_APP_NAME="JankyBorders.app"
JB_SIGNING_IDENTITY_NAME="JankyBorders Local Code Signing"
JB_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
JB_SOURCE_ROOT="$(cd "$JB_SCRIPT_DIR/.." && pwd -P)"
JB_USER_HOME="$(cd "${HOME:?HOME must be set}" && pwd -P)"
JB_INSTALL_ROOT="$JB_USER_HOME/.local/opt/jankyborders"
JB_LOCK_FILE="$JB_INSTALL_ROOT/.service.lock"
JB_BIN_DIR="$JB_USER_HOME/.local/bin"
JB_MAN_DIR="$JB_USER_HOME/.local/share/man/man1"
JB_LAUNCH_AGENTS_DIR="$JB_USER_HOME/Library/LaunchAgents"
JB_LOG_DIR="$JB_USER_HOME/Library/Logs/JankyBorders"
JB_SOURCE_BINARY="$JB_SOURCE_ROOT/bin/borders"
JB_SOURCE_MANPAGE="$JB_SOURCE_ROOT/docs/borders.1"
JB_INFO_PLIST_TEMPLATE="$JB_SOURCE_ROOT/resources/Info.plist.template"
JB_LOGIN_KEYCHAIN="$JB_USER_HOME/Library/Keychains/login.keychain-db"
JB_CURRENT_VERSION_LINK="$JB_INSTALL_ROOT/current"
JB_PREVIOUS_VERSION_LINK="$JB_INSTALL_ROOT/previous"
JB_SIGNING_IDENTITY_FILE="$JB_INSTALL_ROOT/signing-identity.sha1"
JB_STABLE_BINARY="$JB_BIN_DIR/borders"
JB_STABLE_MANPAGE="$JB_MAN_DIR/borders.1"
JB_PLIST="$JB_LAUNCH_AGENTS_DIR/$JB_SERVICE_LABEL.plist"
JB_DOMAIN="gui/$(/usr/bin/id -u)"
JB_SERVICE_TARGET="$JB_DOMAIN/$JB_SERVICE_LABEL"
JB_TEMP_VERSION_DIR=""
JB_TEMP_PLIST=""
JB_TEMP_PLIST_BACKUP=""
JB_TEMP_LINK_DIR=""
JB_TEMP_SIGNING_IDENTITY_FILE=""
JB_TEMP_SIGNING_DIR=""
JB_NEW_SIGNING_IDENTITY=""

jb_cleanup() {
  if [[ -n "$JB_NEW_SIGNING_IDENTITY" ]]; then
    if ! /usr/bin/security delete-identity \
        -Z "$JB_NEW_SIGNING_IDENTITY" \
        -t \
        "$JB_LOGIN_KEYCHAIN" >/dev/null 2>&1; then
      if ! /usr/bin/security delete-certificate \
          -Z "$JB_NEW_SIGNING_IDENTITY" \
          -t \
          "$JB_LOGIN_KEYCHAIN" >/dev/null 2>&1; then
        printf 'local-service: could not roll back newly imported signing identity %s\n' \
          "$JB_NEW_SIGNING_IDENTITY" >&2
      fi
    fi
  fi
  if [[ -n "$JB_TEMP_SIGNING_DIR" && -d "$JB_TEMP_SIGNING_DIR" ]]; then
    if [[ "$JB_TEMP_SIGNING_DIR" == "$JB_INSTALL_ROOT/.signing-bootstrap."* ]]; then
      /bin/rm -R "$JB_TEMP_SIGNING_DIR" 2>/dev/null || true
    fi
  fi
  if [[ -n "$JB_TEMP_VERSION_DIR" && -d "$JB_TEMP_VERSION_DIR" ]]; then
    if [[ "$JB_TEMP_VERSION_DIR" == "$JB_INSTALL_ROOT/.install."* ]]; then
      /bin/rm -R "$JB_TEMP_VERSION_DIR" 2>/dev/null || true
    fi
  fi
  if [[ -n "$JB_TEMP_PLIST" ]]; then
    /bin/rm -f "$JB_TEMP_PLIST" 2>/dev/null || true
  fi
  if [[ -n "$JB_TEMP_PLIST_BACKUP" && -f "$JB_TEMP_PLIST_BACKUP" ]]; then
    printf 'local-service: preserved unrecovered LaunchAgent backup: %s\n' "$JB_TEMP_PLIST_BACKUP" >&2
  fi
  if [[ -n "$JB_TEMP_LINK_DIR" && -d "$JB_TEMP_LINK_DIR" ]]; then
    /bin/rm -f "$JB_TEMP_LINK_DIR/link" 2>/dev/null || true
    /bin/rmdir "$JB_TEMP_LINK_DIR" 2>/dev/null || true
  fi
  if [[ -n "$JB_TEMP_SIGNING_IDENTITY_FILE" ]]; then
    /bin/rm -f "$JB_TEMP_SIGNING_IDENTITY_FILE" 2>/dev/null || true
  fi
}

trap jb_cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

jb_enter_critical_section() {
  trap '' HUP INT TERM
}

jb_leave_critical_section() {
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM
}

jb_usage() {
  /bin/cat <<'EOF'
Usage: scripts/local-service <command>

Commands:
  install    Install this checkout and restart the user LaunchAgent
  rollback   Swap to the previously installed version and restart
  start      Start the installed user LaunchAgent
  stop       Stop the user LaunchAgent
  restart    Restart the installed user LaunchAgent
  status     Show the installed version and LaunchAgent status
  uninstall  Stop the service and remove managed entry points
  signing-help       Show how to create and configure the local signing identity
  setup-signing      Create and configure the local signing identity automatically
  signing-status     Validate the configured signing identity
  configure-signing  Save JANKYBORDERS_SIGNING_IDENTITY (a 40-digit SHA-1 fingerprint)
  screen-capture-status   Check permission as the installed signed app
  request-screen-capture  Explicitly request permission as the installed signed app
EOF
}

jb_die() {
  printf 'local-service: %s\n' "$*" >&2
  exit 1
}

jb_info() {
  printf 'local-service: %s\n' "$*"
}

jb_require_supported_environment() {
  [[ "$(/usr/bin/uname -s)" == "Darwin" ]] || jb_die "this installer only supports macOS"
  [[ "$(/usr/bin/id -u)" -ne 0 ]] || jb_die "do not run this user service installer with sudo"
  [[ "$JB_USER_HOME" == /* ]] || jb_die "HOME must be an absolute path"
  [[ "$JB_INSTALL_ROOT" == "$JB_USER_HOME/"* ]] || jb_die "install root must be below HOME"
  [[ "$JB_BIN_DIR" == "$JB_USER_HOME/"* ]] || jb_die "binary directory must be below HOME"
  [[ "$JB_MAN_DIR" == "$JB_USER_HOME/"* ]] || jb_die "man-page directory must be below HOME"
  [[ "$JB_LAUNCH_AGENTS_DIR" == "$JB_USER_HOME/"* ]] || jb_die "LaunchAgents directory must be below HOME"
  [[ "$JB_LOG_DIR" == "$JB_USER_HOME/"* ]] || jb_die "log directory must be below HOME"
}

jb_acquire_lock() {
  local jb_fd_identity
  local jb_lock_identity
  local jb_old_umask

  [[ ! -L "$JB_INSTALL_ROOT" ]] || jb_die "install root must not be a symlink: $JB_INSTALL_ROOT"
  [[ ! -e "$JB_INSTALL_ROOT" || -d "$JB_INSTALL_ROOT" ]] || jb_die "install root is not a directory: $JB_INSTALL_ROOT"
  /bin/mkdir -p "$JB_INSTALL_ROOT"
  [[ ! -L "$JB_LOCK_FILE" ]] || jb_die "service lock must not be a symlink: $JB_LOCK_FILE"
  [[ ! -e "$JB_LOCK_FILE" || -f "$JB_LOCK_FILE" ]] || jb_die "service lock is not a regular file: $JB_LOCK_FILE"

  jb_old_umask="$(umask)"
  umask 077
  if ! exec 9>>"$JB_LOCK_FILE"; then
    umask "$jb_old_umask"
    jb_die "could not open service lock: $JB_LOCK_FILE"
  fi
  umask "$jb_old_umask"

  if [[ -L "$JB_LOCK_FILE" || ! -f "$JB_LOCK_FILE" ]]; then
    exec 9>&-
    jb_die "service lock changed while opening: $JB_LOCK_FILE"
  fi
  jb_lock_identity="$(/usr/bin/stat -f '%i' "$JB_LOCK_FILE")"
  jb_fd_identity="$(/usr/bin/stat -f '%i' /dev/fd/9)"
  if [[ "$jb_lock_identity" != "$jb_fd_identity" ]]; then
    exec 9>&-
    jb_die "service lock identity changed while opening: $JB_LOCK_FILE"
  fi
  /bin/chmod 0600 /dev/fd/9
  if ! /usr/bin/lockf -t 30 9; then
    jb_die "timed out waiting for another local-service operation"
  fi
}

jb_normalize_signing_identity() {
  local jb_identity="$1"

  [[ "$jb_identity" =~ ^[[:xdigit:]]{40}$ ]] || return 1
  printf '%s' "$jb_identity" | /usr/bin/tr '[:lower:]' '[:upper:]'
}

jb_designated_requirement_for_identity() {
  local jb_identifier="$1"
  local jb_identity="$2"
  local jb_requirement_identity

  jb_requirement_identity="$(printf '%s' "$jb_identity" \
    | /usr/bin/tr '[:upper:]' '[:lower:]')"

  printf 'identifier "%s" and certificate leaf = H"%s"\n' \
    "$jb_identifier" \
    "$jb_requirement_identity"
}

jb_login_keychain_available() {
  [[ -f "$JB_LOGIN_KEYCHAIN" && ! -L "$JB_LOGIN_KEYCHAIN" ]] \
    && /usr/bin/security show-keychain-info "$JB_LOGIN_KEYCHAIN" >/dev/null 2>&1
}

jb_signing_identity_available() {
  local jb_identity="$1"

  jb_login_keychain_available || return 1
  /usr/bin/security find-identity -v -p codesigning "$JB_LOGIN_KEYCHAIN" 2>/dev/null \
    | /usr/bin/awk \
        -v fingerprint="$jb_identity" \
        -v expected_name="\"$JB_SIGNING_IDENTITY_NAME\"" \
        'toupper($2) == fingerprint && index($0, expected_name) > 0 { found = 1 } END { exit !found }'
}

jb_valid_named_signing_identities() {
  jb_login_keychain_available || return 1
  /usr/bin/security find-identity -v -p codesigning "$JB_LOGIN_KEYCHAIN" 2>/dev/null \
    | /usr/bin/awk \
        -v expected_name="\"$JB_SIGNING_IDENTITY_NAME\"" \
        'index($0, expected_name) > 0 { print toupper($2) }'
}

jb_read_signing_identity() {
  local jb_raw_identity

  [[ -e "$JB_SIGNING_IDENTITY_FILE" ]] \
    || jb_die "signing identity is not configured; run 'make setup-signing' first"
  [[ ! -L "$JB_SIGNING_IDENTITY_FILE" ]] \
    || jb_die "signing identity configuration must not be a symlink: $JB_SIGNING_IDENTITY_FILE"
  [[ -f "$JB_SIGNING_IDENTITY_FILE" ]] \
    || jb_die "signing identity configuration is not a regular file: $JB_SIGNING_IDENTITY_FILE"

  jb_raw_identity="$(<"$JB_SIGNING_IDENTITY_FILE")"
  if ! JB_SIGNING_IDENTITY="$(jb_normalize_signing_identity "$jb_raw_identity")"; then
    jb_die "signing identity configuration must contain exactly one 40-digit SHA-1 fingerprint"
  fi
}

jb_require_configured_signing_identity() {
  jb_read_signing_identity
  jb_signing_identity_available "$JB_SIGNING_IDENTITY" \
    || jb_die "configured identity $JB_SIGNING_IDENTITY is not a valid '$JB_SIGNING_IDENTITY_NAME' code-signing identity with a private key"
}

jb_signing_help() {
  /bin/cat <<EOF
JankyBorders local service updates require one stable signing identity.

Recommended one-command setup:
  make setup-signing

This creates a local-only code-signing identity in your login keychain. macOS
may prompt you to unlock the keychain and approve a user-level trust setting
limited to code signing.
The same setup runs automatically on the first 'make install-service'.

Manual alternative in Keychain Access:
  1. Open Certificate Assistant > Create a Certificate.
  2. Set Name to: $JB_SIGNING_IDENTITY_NAME
  3. Set Identity Type to: Self Signed Root
  4. Set Certificate Type to: Code Signing
  5. Enable "Let me override defaults" and set Validity Period to 3650 days.
  6. Finish creation and keep the private key in your login keychain.

Find its 40-digit SHA-1 fingerprint:
  security find-identity -v -p codesigning "$JB_LOGIN_KEYCHAIN"

Configure that exact fingerprint:
  make configure-signing JANKYBORDERS_SIGNING_IDENTITY=YOUR_40_HEX_SHA1

The setup never modifies system/admin trust, never exports the imported private
key, never grants all applications access, and never replaces an existing item.
EOF
}

jb_signing_status() {
  local jb_identity

  if [[ ! -e "$JB_SIGNING_IDENTITY_FILE" ]]; then
    printf 'signing identity: not configured\n'
    printf 'configuration: %s\n' "$JB_SIGNING_IDENTITY_FILE"
    return 1
  fi

  jb_read_signing_identity
  jb_identity="$JB_SIGNING_IDENTITY"
  printf 'signing identity: %s\n' "$jb_identity"
  printf 'expected name: %s\n' "$JB_SIGNING_IDENTITY_NAME"
  printf 'configuration: %s\n' "$JB_SIGNING_IDENTITY_FILE"
  if jb_signing_identity_available "$jb_identity"; then
    printf 'status: valid code-signing identity with private key\n'
    return 0
  fi

  printf 'status: unavailable, invalid, wrong name, or missing private key\n'
  return 1
}

jb_service_loaded() {
  /bin/launchctl print "$JB_SERVICE_TARGET" >/dev/null 2>&1
}

jb_border_pids() {
  /usr/bin/pgrep -u "$(/usr/bin/id -u)" -x borders 2>/dev/null || true
}

jb_require_no_homebrew_service() {
  local jb_target

  for jb_target in \
    "$JB_DOMAIN/homebrew.mxcl.borders" \
    "user/$(/usr/bin/id -u)/homebrew.mxcl.borders" \
    "system/homebrew.mxcl.borders"; do
    if /bin/launchctl print "$jb_target" >/dev/null 2>&1; then
      jb_die "the Homebrew borders service is loaded at $jb_target; run 'brew services stop borders' first"
    fi
  done
}

jb_validate_managed_link() {
  local jb_path="$1"
  local jb_expected_target="$2"
  local jb_target

  if [[ -L "$jb_path" ]]; then
    jb_target="$(/usr/bin/readlink "$jb_path")"
    if [[ "$jb_target" != "$jb_expected_target" ]]; then
      jb_die "refusing to replace unmanaged symlink: $jb_path -> $jb_target"
    fi
    if [[ -d "$jb_path" ]]; then
      jb_die "refusing to replace a directory symlink: $jb_path -> $jb_target"
    fi
  elif [[ -e "$jb_path" ]]; then
    jb_die "refusing to replace unmanaged path: $jb_path"
  fi
}

jb_version_root_is_managed() {
  local jb_version_root="$1"
  local jb_parent
  local jb_name

  [[ "$jb_version_root" == /* ]] || return 1
  jb_parent="$(/usr/bin/dirname "$jb_version_root")" || return 1
  jb_name="$(/usr/bin/basename "$jb_version_root")" || return 1
  [[ "$jb_parent" == "$JB_INSTALL_ROOT"
    && -n "$jb_name"
    && "$jb_name" != "."
    && "$jb_name" != ".." ]]
}

jb_validate_version_link() {
  local jb_path="$1"
  local jb_target

  [[ -e "$jb_path" || -L "$jb_path" ]] || return 0
  [[ -L "$jb_path" ]] || jb_die "refusing to replace unmanaged version path: $jb_path"
  jb_target="$(/usr/bin/readlink "$jb_path")"
  jb_version_root_is_managed "$jb_target" \
    || jb_die "invalid managed version link: $jb_path -> $jb_target"
  [[ -d "$jb_target" && ! -L "$jb_target" ]] \
    || jb_die "managed version target is missing or symlinked: $jb_path -> $jb_target"
}

jb_artifact_schema() {
  local jb_version_root="$1"
  local jb_schema

  if [[ -e "$jb_version_root/ARTIFACT_SCHEMA" || -L "$jb_version_root/ARTIFACT_SCHEMA" ]]; then
    [[ -f "$jb_version_root/ARTIFACT_SCHEMA" && ! -L "$jb_version_root/ARTIFACT_SCHEMA" ]] \
      || return 1
    jb_schema="$(<"$jb_version_root/ARTIFACT_SCHEMA")"
    case "$jb_schema" in
      "$JB_ARTIFACT_SCHEMA"|"$JB_LEGACY_ARTIFACT_SCHEMA")
        printf '%s\n' "$jb_schema"
        return 0
        ;;
      *)
        return 1
        ;;
    esac
  fi

  if [[ -x "$jb_version_root/bin/borders" && ! -e "$jb_version_root/$JB_APP_NAME" ]]; then
    printf '%s\n' "$JB_LEGACY_ARTIFACT_SCHEMA"
    return 0
  fi
  return 1
}

jb_version_binary() {
  local jb_version_root="$1"
  local jb_schema

  jb_schema="$(jb_artifact_schema "$jb_version_root")" || return 1
  case "$jb_schema" in
    "$JB_ARTIFACT_SCHEMA")
      printf '%s/%s/Contents/MacOS/borders\n' "$jb_version_root" "$JB_APP_NAME"
      ;;
    "$JB_LEGACY_ARTIFACT_SCHEMA")
      printf '%s/bin/borders\n' "$jb_version_root"
      ;;
  esac
}

jb_codesign_identifier() {
  /usr/bin/codesign -dvv "$1" 2>&1 \
    | /usr/bin/awk -F= '/^Identifier=/ { print substr($0, index($0, "=") + 1); found = 1; exit } END { exit !found }'
}

jb_codesign_designated_requirement() {
  /usr/bin/codesign -d -r- "$1" 2>&1 \
    | /usr/bin/awk '/^designated => / { sub(/^designated => /, ""); print; found = 1; exit } END { exit !found }'
}

jb_plist_value_is() {
  local jb_plist="$1"
  local jb_key="$2"
  local jb_type="$3"
  local jb_expected="$4"
  local jb_actual

  jb_actual="$(/usr/bin/plutil -extract "$jb_key" raw -expect "$jb_type" "$jb_plist" 2>/dev/null)" \
    || return 1
  [[ "$jb_actual" == "$jb_expected" ]]
}

jb_legacy_artifact_valid() {
  local jb_version_root="$1"
  local jb_binary="$jb_version_root/bin/borders"
  local jb_recorded_digest
  local jb_actual_digest

  [[ -x "$jb_binary" && ! -L "$jb_binary" ]] || return 1
  [[ -f "$jb_version_root/INSTALLED_BINARY_SHA256" && ! -L "$jb_version_root/INSTALLED_BINARY_SHA256" ]] \
    || return 1
  /usr/bin/codesign --verify --strict "$jb_binary" >/dev/null 2>&1 || return 1
  [[ "$(jb_codesign_identifier "$jb_binary")" == "$JB_SERVICE_LABEL" ]] || return 1
  jb_recorded_digest="$(<"$jb_version_root/INSTALLED_BINARY_SHA256")"
  jb_actual_digest="$(/usr/bin/shasum -a 256 "$jb_binary" | /usr/bin/awk '{print $1}')"
  [[ "$jb_recorded_digest" == "$jb_actual_digest" ]]
}

jb_app_artifact_valid() {
  local jb_version_root="$1"
  local jb_app="$jb_version_root/$JB_APP_NAME"
  local jb_binary="$jb_app/Contents/MacOS/borders"
  local jb_command_link="$jb_version_root/bin/borders"
  local jb_plist="$jb_app/Contents/Info.plist"
  local jb_identity
  local jb_recorded_digest
  local jb_actual_digest
  local jb_recorded_requirement
  local jb_actual_requirement
  local jb_expected_requirement
  local jb_bundle_version

  [[ -d "$jb_app" && ! -L "$jb_app" ]] || return 1
  [[ -x "$jb_binary" && ! -L "$jb_binary" ]] || return 1
  [[ -L "$jb_command_link" ]] || return 1
  [[ "$(/usr/bin/readlink "$jb_command_link")" == "../$JB_APP_NAME/Contents/MacOS/borders" ]] || return 1
  [[ -f "$jb_plist" && ! -L "$jb_plist" ]] || return 1
  [[ -f "$jb_version_root/INSTALLED_BINARY_SHA256" && ! -L "$jb_version_root/INSTALLED_BINARY_SHA256" ]] \
    || return 1
  [[ -f "$jb_version_root/SIGNING_IDENTITY_SHA1" && ! -L "$jb_version_root/SIGNING_IDENTITY_SHA1" ]] \
    || return 1
  [[ -f "$jb_version_root/DESIGNATED_REQUIREMENT" && ! -L "$jb_version_root/DESIGNATED_REQUIREMENT" ]] \
    || return 1

  jb_plist_value_is "$jb_plist" CFBundleIdentifier string "$JB_SERVICE_LABEL" || return 1
  jb_plist_value_is "$jb_plist" CFBundleDisplayName string JankyBorders || return 1
  jb_plist_value_is "$jb_plist" CFBundleInfoDictionaryVersion string 6.0 || return 1
  jb_plist_value_is "$jb_plist" CFBundleName string JankyBorders || return 1
  jb_plist_value_is "$jb_plist" CFBundleExecutable string borders || return 1
  jb_plist_value_is "$jb_plist" CFBundlePackageType string APPL || return 1
  jb_plist_value_is "$jb_plist" CFBundleShortVersionString string 1.9.0 || return 1
  jb_bundle_version="$(/usr/bin/plutil -extract CFBundleVersion raw -expect string "$jb_plist" 2>/dev/null)" \
    || return 1
  [[ "$jb_bundle_version" =~ ^[1-9][0-9]*$ ]] || return 1
  jb_plist_value_is "$jb_plist" LSMinimumSystemVersion string 14.0 || return 1
  jb_plist_value_is "$jb_plist" LSUIElement bool true || return 1
  jb_plist_value_is "$jb_plist" NSHighResolutionCapable bool true || return 1
  jb_plist_value_is "$jb_plist" NSScreenCaptureUsageDescription string \
    "JankyBorders only samples window-edge pixels to choose a high-contrast border color." || return 1

  jb_identity="$(<"$jb_version_root/SIGNING_IDENTITY_SHA1")"
  jb_identity="$(jb_normalize_signing_identity "$jb_identity")" || return 1
  jb_expected_requirement="$(jb_designated_requirement_for_identity \
    "$JB_SERVICE_LABEL" \
    "$jb_identity")" || return 1
  /usr/bin/codesign --verify --strict "$jb_app" >/dev/null 2>&1 || return 1
  [[ "$(jb_codesign_identifier "$jb_app")" == "$JB_SERVICE_LABEL" ]] || return 1
  /usr/bin/codesign --verify --strict \
    "-R=$jb_expected_requirement" "$jb_app" >/dev/null 2>&1 \
    || return 1

  jb_recorded_requirement="$(<"$jb_version_root/DESIGNATED_REQUIREMENT")"
  jb_actual_requirement="$(jb_codesign_designated_requirement "$jb_app")" || return 1
  [[ "$jb_recorded_requirement" == "$jb_expected_requirement" ]] || return 1
  [[ "$jb_actual_requirement" == "$jb_expected_requirement" ]] || return 1

  jb_recorded_digest="$(<"$jb_version_root/INSTALLED_BINARY_SHA256")"
  jb_actual_digest="$(/usr/bin/shasum -a 256 "$jb_binary" | /usr/bin/awk '{print $1}')"
  [[ "$jb_recorded_digest" == "$jb_actual_digest" ]]
}

jb_version_artifact_valid() {
  local jb_version_root="$1"
  local jb_schema

  [[ -d "$jb_version_root" && ! -L "$jb_version_root" ]] \
    && jb_version_root_is_managed "$jb_version_root" \
    || return 1
  jb_schema="$(jb_artifact_schema "$jb_version_root")" || return 1
  case "$jb_schema" in
    "$JB_ARTIFACT_SCHEMA")
      jb_app_artifact_valid "$jb_version_root"
      ;;
    "$JB_LEGACY_ARTIFACT_SCHEMA")
      jb_legacy_artifact_valid "$jb_version_root"
      ;;
  esac
}

jb_validate_version_artifact() {
  local jb_version_root="$1"

  jb_version_artifact_valid "$jb_version_root" \
    || jb_die "invalid or incompatible version artifact: $jb_version_root"
}

jb_assert_managed_v2_identity_compatible() {
  local jb_requested_identity="$1"
  local jb_link
  local jb_version_root
  local jb_schema
  local jb_recorded_identity

  for jb_link in "$JB_CURRENT_VERSION_LINK" "$JB_PREVIOUS_VERSION_LINK"; do
    [[ -L "$jb_link" ]] || continue
    jb_version_root="$(/usr/bin/readlink "$jb_link")"
    jb_version_root_is_managed "$jb_version_root" \
      || jb_die "managed version target is outside the install root: $jb_link -> $jb_version_root"
    [[ -d "$jb_version_root" && ! -L "$jb_version_root" ]] \
      || jb_die "managed version target is missing or symlinked: $jb_link -> $jb_version_root"
    jb_schema="$(jb_artifact_schema "$jb_version_root")" \
      || jb_die "managed version has an unknown artifact schema: $jb_version_root"
    [[ "$jb_schema" == "$JB_ARTIFACT_SCHEMA" ]] || continue
    jb_validate_version_artifact "$jb_version_root"
    jb_recorded_identity="$(<"$jb_version_root/SIGNING_IDENTITY_SHA1")"
    [[ "$jb_recorded_identity" == "$jb_requested_identity" ]] \
      || jb_die "refusing signing identity change while managed app-v2 artifacts exist: $jb_version_root uses $jb_recorded_identity"
  done
}

jb_assert_designated_requirement_compatible() {
  local jb_new_version_root="$1"
  local jb_current_root
  local jb_current_schema
  local jb_new_schema
  local jb_new_requirement
  local jb_current_requirement

  [[ -L "$JB_CURRENT_VERSION_LINK" ]] || return 0
  jb_current_root="$(/usr/bin/readlink "$JB_CURRENT_VERSION_LINK")"
  jb_current_schema="$(jb_artifact_schema "$jb_current_root")" || return 1
  jb_new_schema="$(jb_artifact_schema "$jb_new_version_root")" || return 1
  if [[ "$jb_current_schema" != "$JB_ARTIFACT_SCHEMA" || "$jb_new_schema" != "$JB_ARTIFACT_SCHEMA" ]]; then
    return 0
  fi

  jb_validate_version_artifact "$jb_current_root"
  jb_validate_version_artifact "$jb_new_version_root"
  jb_current_requirement="$(<"$jb_current_root/DESIGNATED_REQUIREMENT")"
  jb_new_requirement="$(<"$jb_new_version_root/DESIGNATED_REQUIREMENT")"
  [[ "$jb_current_requirement" == "$jb_new_requirement" ]] \
    || jb_die "new app has an incompatible designated requirement; the running service was not stopped"
}

jb_persist_signing_identity() {
  local jb_requested_identity="$1"

  jb_assert_managed_v2_identity_compatible "$jb_requested_identity"
  [[ ! -L "$JB_SIGNING_IDENTITY_FILE" ]] \
    || jb_die "refusing to replace symlinked signing identity configuration: $JB_SIGNING_IDENTITY_FILE"
  [[ ! -e "$JB_SIGNING_IDENTITY_FILE" || -f "$JB_SIGNING_IDENTITY_FILE" ]] \
    || jb_die "refusing to replace non-regular signing identity configuration: $JB_SIGNING_IDENTITY_FILE"

  JB_TEMP_SIGNING_IDENTITY_FILE="$(/usr/bin/mktemp "$JB_INSTALL_ROOT/.signing-identity.XXXXXX")"
  /bin/chmod 0600 "$JB_TEMP_SIGNING_IDENTITY_FILE"
  printf '%s\n' "$jb_requested_identity" >"$JB_TEMP_SIGNING_IDENTITY_FILE"
  /bin/mv -f "$JB_TEMP_SIGNING_IDENTITY_FILE" "$JB_SIGNING_IDENTITY_FILE"
  JB_TEMP_SIGNING_IDENTITY_FILE=""
}

jb_configure_signing() {
  local jb_requested_identity="${JANKYBORDERS_SIGNING_IDENTITY:-}"

  [[ -n "$jb_requested_identity" ]] \
    || jb_die "JANKYBORDERS_SIGNING_IDENTITY must be set to the certificate's 40-digit SHA-1 fingerprint"
  if ! jb_requested_identity="$(jb_normalize_signing_identity "$jb_requested_identity")"; then
    jb_die "JANKYBORDERS_SIGNING_IDENTITY must be exactly 40 hexadecimal digits"
  fi
  jb_signing_identity_available "$jb_requested_identity" \
    || jb_die "$jb_requested_identity is not a valid '$JB_SIGNING_IDENTITY_NAME' code-signing identity with a private key"
  jb_persist_signing_identity "$jb_requested_identity"
  jb_info "configured signing identity $jb_requested_identity"
}

jb_setup_signing() {
  local jb_existing_identities
  local jb_existing_count
  local jb_existing_identity
  local jb_old_umask
  local jb_private_key_pem
  local jb_restore_xtrace=0
  local jb_certificate
  local jb_fingerprint
  local jb_probe
  local jb_probe_requirement
  local jb_query_status

  jb_login_keychain_available \
    || jb_die "login keychain is unavailable, invalid, or symlinked: $JB_LOGIN_KEYCHAIN"

  if [[ -e "$JB_SIGNING_IDENTITY_FILE" || -L "$JB_SIGNING_IDENTITY_FILE" ]]; then
    jb_require_configured_signing_identity
    jb_info "signing identity is already configured: $JB_SIGNING_IDENTITY"
    return 0
  fi

  if ! jb_existing_identities="$(jb_valid_named_signing_identities)"; then
    jb_die "could not inspect code-signing identities in the login keychain"
  fi
  if [[ -n "$jb_existing_identities" ]]; then
    jb_existing_count="$(printf '%s\n' "$jb_existing_identities" \
      | /usr/bin/awk 'NF { count++ } END { print count + 0 }')"
    [[ "$jb_existing_count" == "1" ]] \
      || jb_die "multiple valid '$JB_SIGNING_IDENTITY_NAME' identities exist; configure one exact fingerprint manually"
    jb_existing_identity="$(printf '%s\n' "$jb_existing_identities" | /usr/bin/awk 'NF { print; exit }')"
    jb_persist_signing_identity "$jb_existing_identity"
    jb_info "configured signing identity $jb_existing_identity"
    jb_info "reused the existing login-keychain identity"
    return 0
  fi

  if /usr/bin/security find-certificate \
      -c "$JB_SIGNING_IDENTITY_NAME" \
      "$JB_LOGIN_KEYCHAIN" >/dev/null 2>&1; then
    jb_die "an unusable '$JB_SIGNING_IDENTITY_NAME' certificate already exists; inspect it in the login keychain instead of overwriting it"
  else
    jb_query_status=$?
    [[ "$jb_query_status" == "44" ]] \
      || jb_die "could not inspect certificates in the login keychain"
  fi
  jb_old_umask="$(umask)"
  umask 077
  JB_TEMP_SIGNING_DIR="$(/usr/bin/mktemp -d "$JB_INSTALL_ROOT/.signing-bootstrap.XXXXXX")"
  umask "$jb_old_umask"
  /bin/chmod 0700 "$JB_TEMP_SIGNING_DIR"
  jb_certificate="$JB_TEMP_SIGNING_DIR/identity.pem"
  jb_probe="$JB_TEMP_SIGNING_DIR/signing-probe"

  jb_info "creating a local-only code-signing identity in the login keychain"
  # Keep the private key in shell memory and anonymous pipes only. Disable
  # tracing around the secret so `bash -x` cannot print it.
  ulimit -c 0 || jb_die "could not disable core dumps during key generation"
  if [[ "$-" == *x* ]]; then
    set +x
    jb_restore_xtrace=1
  fi
  if ! jb_private_key_pem="$(/usr/bin/openssl genrsa 3072 2>/dev/null)"; then
    jb_die "could not generate the local private key"
  fi
  printf '%s\n' "$jb_private_key_pem" | /usr/bin/openssl req \
    -new \
    -x509 \
    -key /dev/stdin \
    -sha256 \
    -days 3650 \
    -subj "/CN=$JB_SIGNING_IDENTITY_NAME" \
    -addext 'basicConstraints=critical,CA:TRUE,pathlen:0' \
    -addext 'keyUsage=critical,digitalSignature,keyCertSign' \
    -addext 'extendedKeyUsage=critical,1.3.6.1.5.5.7.3.3' \
    -addext 'subjectKeyIdentifier=hash' \
    -addext 'authorityKeyIdentifier=keyid:always' \
    -out "$jb_certificate" >/dev/null 2>&1 \
    || jb_die "could not generate the local code-signing identity"
  /bin/chmod 0600 "$jb_certificate"

  jb_fingerprint="$(/usr/bin/openssl x509 \
    -in "$jb_certificate" \
    -noout \
    -fingerprint \
    -sha1 \
    | /usr/bin/awk -F= 'NF == 2 { print $2 }' \
    | /usr/bin/tr -d ':')"
  if ! jb_fingerprint="$(jb_normalize_signing_identity "$jb_fingerprint")"; then
    jb_die "generated certificate did not have a valid SHA-1 fingerprint"
  fi

  JB_NEW_SIGNING_IDENTITY="$jb_fingerprint"
  /usr/bin/security import "$jb_certificate" \
    -k "$JB_LOGIN_KEYCHAIN" \
    -t cert \
    -f openssl >/dev/null \
    || jb_die "could not import the local signing certificate into the login keychain"
  if ! printf '%s\n' "$jb_private_key_pem" | /usr/bin/security import /dev/stdin \
      -k "$JB_LOGIN_KEYCHAIN" \
      -t priv \
      -f openssl \
      -x \
      -T /usr/bin/codesign >/dev/null; then
    unset jb_private_key_pem
    if [[ "$jb_restore_xtrace" == "1" ]]; then
      set -x
    fi
    jb_die "could not import the local private key into the login keychain"
  fi
  unset jb_private_key_pem
  if [[ "$jb_restore_xtrace" == "1" ]]; then
    set -x
  fi

  jb_info "macOS may now prompt you to approve this identity for code signing"
  /usr/bin/security add-trusted-cert \
    -r trustRoot \
    -p codeSign \
    -k "$JB_LOGIN_KEYCHAIN" \
    "$jb_certificate" >/dev/null \
    || jb_die "code-signing trust was not approved; the new identity will be removed"

  /usr/bin/security verify-cert \
    -q \
    -L \
    -l \
    -p codeSign \
    -c "$jb_certificate" \
    -k "$JB_LOGIN_KEYCHAIN" \
    || jb_die "the new identity did not pass code-signing trust verification"
  jb_signing_identity_available "$jb_fingerprint" \
    || jb_die "the new identity is not available for code signing"

  /bin/cp /usr/bin/true "$jb_probe"
  /bin/chmod 0700 "$jb_probe"
  jb_probe_requirement="$(jb_designated_requirement_for_identity \
    "$JB_SERVICE_LABEL.signing-probe" \
    "$jb_fingerprint")"
  /usr/bin/codesign \
    --force \
    --timestamp=none \
    --keychain "$JB_LOGIN_KEYCHAIN" \
    --sign "$jb_fingerprint" \
    --identifier "$JB_SERVICE_LABEL.signing-probe" \
    "-r=designated => $jb_probe_requirement" \
    "$jb_probe" >/dev/null 2>&1 \
    || jb_die "the new private key could not sign a local probe"
  /usr/bin/codesign --verify --strict \
    "-R=$jb_probe_requirement" \
    "$jb_probe" >/dev/null 2>&1 \
    || jb_die "the local signing probe did not verify"
  [[ "$(jb_codesign_designated_requirement "$jb_probe")" == "$jb_probe_requirement" ]] \
    || jb_die "the local signing probe has an unexpected designated requirement"

  /bin/rm "$jb_certificate" "$jb_probe" \
    || jb_die "could not remove temporary signing material"
  /bin/rmdir "$JB_TEMP_SIGNING_DIR" \
    || jb_die "could not remove the temporary signing directory"
  JB_TEMP_SIGNING_DIR=""

  jb_enter_critical_section
  jb_persist_signing_identity "$jb_fingerprint"
  JB_NEW_SIGNING_IDENTITY=""
  jb_leave_critical_section
  jb_info "configured signing identity $jb_fingerprint"
  jb_info "created a stable local signing identity: $jb_fingerprint"
}

jb_validate_managed_plist() {
  local jb_existing_label
  local jb_existing_program

  [[ -e "$JB_PLIST" ]] || return 0
  [[ ! -L "$JB_PLIST" ]] || jb_die "refusing to replace a symlinked LaunchAgent: $JB_PLIST"

  if ! jb_existing_label="$(/usr/bin/plutil -extract Label raw -expect string "$JB_PLIST" 2>/dev/null)"; then
    jb_die "refusing to replace invalid LaunchAgent: $JB_PLIST"
  fi
  if ! jb_existing_program="$(/usr/bin/plutil -extract ProgramArguments.0 raw -expect string "$JB_PLIST" 2>/dev/null)"; then
    jb_die "refusing to replace LaunchAgent without ProgramArguments[0]: $JB_PLIST"
  fi
  if [[ "$jb_existing_label" != "$JB_SERVICE_LABEL" ]]; then
    jb_die "refusing to replace unmanaged LaunchAgent: $JB_PLIST"
  fi
  if [[ "$jb_existing_program" != "$JB_STABLE_BINARY" \
    && "$jb_existing_program" != "$JB_CURRENT_VERSION_LINK/$JB_APP_NAME/Contents/MacOS/borders" ]]; then
    jb_die "refusing to replace unmanaged LaunchAgent: $JB_PLIST"
  fi
}

jb_service_program_for_schema() {
  local jb_schema="$1"

  case "$jb_schema" in
    "$JB_ARTIFACT_SCHEMA")
      printf '%s/%s/Contents/MacOS/borders\n' "$JB_CURRENT_VERSION_LINK" "$JB_APP_NAME"
      ;;
    "$JB_LEGACY_ARTIFACT_SCHEMA")
      printf '%s\n' "$JB_STABLE_BINARY"
      ;;
    *)
      return 1
      ;;
  esac
}

jb_validate_plist_for_version() {
  local jb_version_root="$1"
  local jb_schema
  local jb_expected_program
  local jb_actual_program

  [[ -f "$JB_PLIST" ]] || return 1
  jb_schema="$(jb_artifact_schema "$jb_version_root")" || return 1
  jb_expected_program="$(jb_service_program_for_schema "$jb_schema")" || return 1
  jb_actual_program="$(/usr/bin/plutil -extract ProgramArguments.0 raw -expect string "$JB_PLIST" 2>/dev/null)" \
    || return 1
  [[ "$jb_actual_program" == "$jb_expected_program" ]]
}

jb_atomic_link() {
  local jb_target="$1"
  local jb_link="$2"
  local jb_link_parent

  jb_link_parent="$(/usr/bin/dirname "$jb_link")"
  if ! JB_TEMP_LINK_DIR="$(/usr/bin/mktemp -d "$jb_link_parent/.jankyborders-link.XXXXXX")"; then
    return 1
  fi
  if ! /bin/ln -s "$jb_target" "$JB_TEMP_LINK_DIR/link"; then
    /bin/rmdir "$JB_TEMP_LINK_DIR" 2>/dev/null || true
    JB_TEMP_LINK_DIR=""
    return 1
  fi
  if ! /bin/mv -h -f "$JB_TEMP_LINK_DIR/link" "$jb_link"; then
    /bin/rm -f "$JB_TEMP_LINK_DIR/link"
    /bin/rmdir "$JB_TEMP_LINK_DIR" 2>/dev/null || true
    JB_TEMP_LINK_DIR=""
    return 1
  fi
  /bin/rmdir "$JB_TEMP_LINK_DIR" 2>/dev/null || true
  JB_TEMP_LINK_DIR=""
}

jb_install_version() {
  local jb_revision
  local jb_commit_count
  local jb_binary_digest
  local jb_binary_digest_short
  local jb_version
  local jb_version_root
  local jb_temp_app
  local jb_version_binary
  local jb_temp_binary
  local jb_recorded_source_digest
  local jb_installed_digest
  local jb_designated_requirement

  [[ -x "$JB_SOURCE_BINARY" ]] || jb_die "missing built binary: $JB_SOURCE_BINARY"
  [[ -f "$JB_SOURCE_MANPAGE" ]] || jb_die "missing man page: $JB_SOURCE_MANPAGE"
  [[ -f "$JB_INFO_PLIST_TEMPLATE" && ! -L "$JB_INFO_PLIST_TEMPLATE" ]] \
    || jb_die "missing Info.plist template: $JB_INFO_PLIST_TEMPLATE"
  /usr/bin/plutil -lint "$JB_INFO_PLIST_TEMPLATE" >/dev/null \
    || jb_die "invalid Info.plist template: $JB_INFO_PLIST_TEMPLATE"
  jb_require_configured_signing_identity
  jb_assert_managed_v2_identity_compatible "$JB_SIGNING_IDENTITY"

  jb_revision="$(/usr/bin/git -C "$JB_SOURCE_ROOT" rev-parse --short=12 HEAD 2>/dev/null || true)"
  [[ -n "$jb_revision" ]] || jb_revision="unknown"
  jb_binary_digest="$(/usr/bin/shasum -a 256 "$JB_SOURCE_BINARY" | /usr/bin/awk '{print $1}')"
  jb_binary_digest_short="${jb_binary_digest:0:12}"
  jb_commit_count="$(/usr/bin/git -C "$JB_SOURCE_ROOT" rev-list --count HEAD 2>/dev/null || true)"
  [[ "$jb_commit_count" =~ ^[1-9][0-9]*$ ]] || jb_commit_count=1
  jb_version="$jb_revision-$jb_binary_digest_short-${JB_SIGNING_IDENTITY:0:12}-$JB_ARTIFACT_SCHEMA"
  jb_version_root="$JB_INSTALL_ROOT/$jb_version"
  jb_version_binary="$jb_version_root/$JB_APP_NAME/Contents/MacOS/borders"

  if [[ -d "$jb_version_root" && ! -L "$jb_version_root" ]]; then
    [[ -f "$jb_version_root/SOURCE_BINARY_SHA256" && ! -L "$jb_version_root/SOURCE_BINARY_SHA256" ]] \
      || jb_die "incomplete version directory: $jb_version_root"
    jb_recorded_source_digest="$(<"$jb_version_root/SOURCE_BINARY_SHA256")"
    [[ "$jb_recorded_source_digest" == "$jb_binary_digest" ]] \
      || jb_die "version directory digest collision: $jb_version_root"
    jb_validate_version_artifact "$jb_version_root"
    [[ "$(<"$jb_version_root/SIGNING_IDENTITY_SHA1")" == "$JB_SIGNING_IDENTITY" ]] \
      || jb_die "installed version uses a different signing identity: $jb_version_root"
    jb_plist_value_is "$jb_version_root/$JB_APP_NAME/Contents/Info.plist" \
      CFBundleVersion string "$jb_commit_count" \
      || jb_die "installed version has a different CFBundleVersion: $jb_version_root"
  else
    [[ ! -e "$jb_version_root" && ! -L "$jb_version_root" ]] \
      || jb_die "incomplete version path: $jb_version_root"
    JB_TEMP_VERSION_DIR="$(/usr/bin/mktemp -d "$JB_INSTALL_ROOT/.install.XXXXXX")"
    jb_temp_app="$JB_TEMP_VERSION_DIR/$JB_APP_NAME"
    jb_temp_binary="$jb_temp_app/Contents/MacOS/borders"

    /bin/mkdir -p \
      "$jb_temp_app/Contents/MacOS" \
      "$JB_TEMP_VERSION_DIR/bin" \
      "$JB_TEMP_VERSION_DIR/share/man/man1"
    /usr/bin/install -m 0644 "$JB_INFO_PLIST_TEMPLATE" "$jb_temp_app/Contents/Info.plist"
    /usr/bin/plutil -replace CFBundleVersion -string "$jb_commit_count" "$jb_temp_app/Contents/Info.plist"
    /usr/bin/install -m 0755 "$JB_SOURCE_BINARY" "$jb_temp_binary"
    /usr/bin/install -m 0644 "$JB_SOURCE_MANPAGE" "$JB_TEMP_VERSION_DIR/share/man/man1/borders.1"
    /bin/ln -s "../$JB_APP_NAME/Contents/MacOS/borders" "$JB_TEMP_VERSION_DIR/bin/borders"
    printf '%s\n' "$JB_ARTIFACT_SCHEMA" >"$JB_TEMP_VERSION_DIR/ARTIFACT_SCHEMA"
    printf '%s\n' "$jb_binary_digest" >"$JB_TEMP_VERSION_DIR/SOURCE_BINARY_SHA256"
    printf '%s\n' "$JB_SIGNING_IDENTITY" >"$JB_TEMP_VERSION_DIR/SIGNING_IDENTITY_SHA1"
    printf '%s\n' \
      "$(/usr/bin/git -C "$JB_SOURCE_ROOT" rev-parse HEAD 2>/dev/null || printf unknown)" \
      >"$JB_TEMP_VERSION_DIR/REVISION"

    jb_designated_requirement="$(jb_designated_requirement_for_identity \
      "$JB_SERVICE_LABEL" \
      "$JB_SIGNING_IDENTITY")"
    /usr/bin/codesign \
      --force \
      --timestamp=none \
      --keychain "$JB_LOGIN_KEYCHAIN" \
      --sign "$JB_SIGNING_IDENTITY" \
      --identifier "$JB_SERVICE_LABEL" \
      "-r=designated => $jb_designated_requirement" \
      "$jb_temp_app" >/dev/null
    /usr/bin/codesign --verify --strict \
      "-R=$jb_designated_requirement" \
      "$jb_temp_app" >/dev/null
    [[ "$(jb_codesign_designated_requirement "$jb_temp_app")" == "$jb_designated_requirement" ]] \
      || jb_die "the signed app has an unexpected designated requirement"
    printf '%s\n' "$jb_designated_requirement" >"$JB_TEMP_VERSION_DIR/DESIGNATED_REQUIREMENT"
    jb_installed_digest="$(/usr/bin/shasum -a 256 "$jb_temp_binary" | /usr/bin/awk '{print $1}')"
    printf '%s\n' "$jb_installed_digest" >"$JB_TEMP_VERSION_DIR/INSTALLED_BINARY_SHA256"

    jb_app_artifact_valid "$JB_TEMP_VERSION_DIR" \
      || jb_die "newly signed app-v2 artifact failed validation"
    /bin/mv "$JB_TEMP_VERSION_DIR" "$jb_version_root"
    JB_TEMP_VERSION_DIR=""
  fi

  JB_INSTALLED_VERSION="$jb_version"
  JB_INSTALLED_VERSION_ROOT="$jb_version_root"
  JB_INSTALLED_BINARY="$jb_version_binary"
}

jb_activate_version() {
  local jb_version_root="$1"
  local jb_old_current=""
  local jb_old_previous=""

  jb_validate_version_artifact "$jb_version_root"
  [[ -f "$jb_version_root/share/man/man1/borders.1" ]] || jb_die "versioned man page is missing under $jb_version_root"

  /bin/mkdir -p "$JB_INSTALL_ROOT" "$JB_BIN_DIR" "$JB_MAN_DIR"
  if [[ -L "$JB_CURRENT_VERSION_LINK" ]]; then
    jb_old_current="$(/usr/bin/readlink "$JB_CURRENT_VERSION_LINK")"
  fi
  if [[ -L "$JB_PREVIOUS_VERSION_LINK" ]]; then
    jb_old_previous="$(/usr/bin/readlink "$JB_PREVIOUS_VERSION_LINK")"
    if ! jb_version_artifact_valid "$jb_old_previous"; then
      /bin/rm "$JB_PREVIOUS_VERSION_LINK" || return 1
    fi
  fi
  if [[ -n "$jb_old_current" && "$jb_old_current" != "$jb_version_root" ]]; then
    if jb_version_artifact_valid "$jb_old_current"; then
      jb_atomic_link "$jb_old_current" "$JB_PREVIOUS_VERSION_LINK" || return 1
    else
      jb_info "not recording incompatible artifact as previous: $jb_old_current"
    fi
  fi
  jb_atomic_link "$jb_version_root" "$JB_CURRENT_VERSION_LINK" || return 1
  jb_atomic_link "$JB_CURRENT_VERSION_LINK/bin/borders" "$JB_STABLE_BINARY" || return 1
  jb_atomic_link "$JB_CURRENT_VERSION_LINK/share/man/man1/borders.1" "$JB_STABLE_MANPAGE" || return 1
}

jb_restore_link() {
  local jb_target="$1"
  local jb_link="$2"
  local jb_active_target

  if [[ -n "$jb_target" ]]; then
    jb_atomic_link "$jb_target" "$jb_link"
    return $?
  fi

  if [[ -L "$jb_link" ]]; then
    jb_active_target="$(/usr/bin/readlink "$jb_link")"
    [[ "$jb_active_target" == "$JB_INSTALL_ROOT/"* ]] || return 1
    /bin/rm "$jb_link" || return 1
  elif [[ -e "$jb_link" ]]; then
    return 1
  fi
}

jb_restore_install_links() {
  local jb_old_current="$1"
  local jb_old_previous="$2"
  local jb_old_stable_binary="$3"
  local jb_old_stable_manpage="$4"
  local jb_result=0

  jb_restore_link "$jb_old_current" "$JB_CURRENT_VERSION_LINK" || jb_result=1
  jb_restore_link "$jb_old_previous" "$JB_PREVIOUS_VERSION_LINK" || jb_result=1
  jb_restore_link "$jb_old_stable_binary" "$JB_STABLE_BINARY" || jb_result=1
  jb_restore_link "$jb_old_stable_manpage" "$JB_STABLE_MANPAGE" || jb_result=1
  return "$jb_result"
}

jb_backup_plist() {
  local jb_backup

  [[ -f "$JB_PLIST" ]] || return 0

  /bin/mkdir -p "$JB_LAUNCH_AGENTS_DIR"
  jb_backup="$(/usr/bin/mktemp "$JB_LAUNCH_AGENTS_DIR/.$JB_SERVICE_LABEL.backup.XXXXXX")"
  if ! /bin/cp -p "$JB_PLIST" "$jb_backup"; then
    /bin/rm -f "$jb_backup" 2>/dev/null || true
    return 1
  fi
  JB_TEMP_PLIST_BACKUP="$jb_backup"
}

jb_restore_plist() {
  if [[ -n "$JB_TEMP_PLIST_BACKUP" ]]; then
    /bin/mv -f "$JB_TEMP_PLIST_BACKUP" "$JB_PLIST" || return 1
    JB_TEMP_PLIST_BACKUP=""
  else
    /bin/rm -f "$JB_PLIST" || return 1
  fi
}

jb_restore_install_state() {
  local jb_old_current="$1"
  local jb_old_previous="$2"
  local jb_old_stable_binary="$3"
  local jb_old_stable_manpage="$4"
  local jb_result=0

  jb_restore_install_links "$jb_old_current" "$jb_old_previous" "$jb_old_stable_binary" "$jb_old_stable_manpage" \
    || jb_result=1
  jb_restore_plist || jb_result=1
  return "$jb_result"
}

jb_restore_rollback_state() {
  local jb_current="$1"
  local jb_previous="$2"
  local jb_result=0

  jb_atomic_link "$jb_current" "$JB_CURRENT_VERSION_LINK" || jb_result=1
  jb_atomic_link "$jb_previous" "$JB_PREVIOUS_VERSION_LINK" || jb_result=1
  jb_restore_plist || jb_result=1
  return "$jb_result"
}

jb_discard_plist_backup() {
  if [[ -n "$JB_TEMP_PLIST_BACKUP" ]]; then
    /bin/rm -f "$JB_TEMP_PLIST_BACKUP"
    JB_TEMP_PLIST_BACKUP=""
  fi
}

jb_prepare_plist() {
  local jb_schema="$1"
  local jb_program
  local jb_service_path
  local jb_lang

  jb_program="$(jb_service_program_for_schema "$jb_schema")" || return 1
  /bin/mkdir -p "$JB_LAUNCH_AGENTS_DIR" "$JB_LOG_DIR" || return 1
  JB_TEMP_PLIST="$(/usr/bin/mktemp "$JB_LAUNCH_AGENTS_DIR/.$JB_SERVICE_LABEL.XXXXXX")" || return 1
  jb_service_path="$JB_BIN_DIR:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  jb_lang="${LANG:-en_US.UTF-8}"

  /usr/bin/plutil -create xml1 "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert Label -string "$JB_SERVICE_LABEL" "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert ProgramArguments -array "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert ProgramArguments.0 -string "$jb_program" "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert RunAtLoad -bool YES "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert KeepAlive -bool YES "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert ProcessType -string Interactive "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert StandardOutPath -string "$JB_LOG_DIR/borders.out.log" "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert StandardErrorPath -string "$JB_LOG_DIR/borders.err.log" "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert EnvironmentVariables -dictionary "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert EnvironmentVariables.HOME -string "$JB_USER_HOME" "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert EnvironmentVariables.PATH -string "$jb_service_path" "$JB_TEMP_PLIST" || return 1
  /usr/bin/plutil -insert EnvironmentVariables.LANG -string "$jb_lang" "$JB_TEMP_PLIST" || return 1

  if [[ -n "${XDG_CONFIG_HOME:-}" && "$XDG_CONFIG_HOME" == /* ]]; then
    /usr/bin/plutil -insert EnvironmentVariables.XDG_CONFIG_HOME -string "$XDG_CONFIG_HOME" "$JB_TEMP_PLIST" || return 1
  fi

  /usr/bin/plutil -lint "$JB_TEMP_PLIST" >/dev/null || return 1
  /bin/chmod 0644 "$JB_TEMP_PLIST" || return 1
}

jb_commit_prepared_plist() {
  [[ -n "$JB_TEMP_PLIST" && -f "$JB_TEMP_PLIST" && ! -L "$JB_TEMP_PLIST" ]] || return 1
  /bin/mv -f "$JB_TEMP_PLIST" "$JB_PLIST" || return 1
  JB_TEMP_PLIST=""
}

jb_wait_for_unloaded() {
  local jb_attempt=0

  while jb_service_loaded && [[ "$jb_attempt" -lt 50 ]]; do
    /bin/sleep 0.1
    jb_attempt=$((jb_attempt + 1))
  done
  if jb_service_loaded; then
    printf 'local-service: LaunchAgent did not unload: %s\n' "$JB_SERVICE_TARGET" >&2
    return 1
  fi
}

jb_wait_for_no_border_processes() {
  local jb_attempt=0
  local jb_pids

  jb_pids="$(jb_border_pids)"
  while [[ -n "$jb_pids" && "$jb_attempt" -lt 50 ]]; do
    /bin/sleep 0.1
    jb_attempt=$((jb_attempt + 1))
    jb_pids="$(jb_border_pids)"
  done
  if [[ -n "$jb_pids" ]]; then
    printf 'local-service: another borders process is still running (PID: %s)\n' "${jb_pids//$'\n'/, }" >&2
    return 1
  fi
}

jb_wait_for_running() {
  local jb_attempt=0
  local jb_output=""
  local jb_pid=""
  local jb_first_pid=""

  while [[ "$jb_attempt" -lt 50 ]]; do
    if jb_output="$(/bin/launchctl print "$JB_SERVICE_TARGET" 2>&1)"; then
      jb_pid="$(printf '%s\n' "$jb_output" | /usr/bin/awk '/^[[:space:]]*pid = [0-9]+/ { print $3; exit }')"
    else
      jb_pid=""
    fi
    if [[ "$jb_pid" =~ ^[0-9]+$ ]] && /bin/kill -0 "$jb_pid" 2>/dev/null; then
      jb_first_pid="$jb_pid"
      /bin/sleep 1
      if jb_output="$(/bin/launchctl print "$JB_SERVICE_TARGET" 2>&1)"; then
        jb_pid="$(printf '%s\n' "$jb_output" | /usr/bin/awk '/^[[:space:]]*pid = [0-9]+/ { print $3; exit }')"
      else
        jb_pid=""
      fi
      if [[ "$jb_pid" == "$jb_first_pid" ]] && /bin/kill -0 "$jb_pid" 2>/dev/null; then
        return 0
      fi
    fi
    /bin/sleep 0.1
    jb_attempt=$((jb_attempt + 1))
  done

  printf '%s\n' "$jb_output" >&2
  if [[ -f "$JB_LOG_DIR/borders.err.log" ]]; then
    /usr/bin/tail -n 20 "$JB_LOG_DIR/borders.err.log" >&2 || true
  fi
  return 1
}

jb_launchd_pid() {
  /bin/launchctl print "$JB_SERVICE_TARGET" 2>/dev/null \
    | /usr/bin/awk '/^[[:space:]]*pid = [0-9]+/ { print $3; exit }'
}

jb_validate_process_ownership() {
  local jb_launchd_pid=""
  local jb_pid
  local jb_pids

  jb_pids="$(jb_border_pids)"
  if jb_service_loaded; then
    jb_launchd_pid="$(jb_launchd_pid || true)"
    for jb_pid in $jb_pids; do
      [[ -n "$jb_launchd_pid" && "$jb_pid" == "$jb_launchd_pid" ]] \
        || jb_die "an unmanaged borders process is running (PID: $jb_pid)"
    done
  elif [[ -n "$jb_pids" ]]; then
    jb_die "an unmanaged borders process is running (PID: ${jb_pids//$'\n'/, })"
  fi
}

jb_preflight_installed_service() {
  local jb_current_root

  jb_require_no_homebrew_service
  jb_validate_version_link "$JB_CURRENT_VERSION_LINK"
  jb_validate_version_link "$JB_PREVIOUS_VERSION_LINK"
  jb_validate_managed_link "$JB_STABLE_BINARY" \
    "$JB_CURRENT_VERSION_LINK/bin/borders"
  jb_validate_managed_link "$JB_STABLE_MANPAGE" \
    "$JB_CURRENT_VERSION_LINK/share/man/man1/borders.1"
  jb_validate_managed_plist
  [[ -L "$JB_CURRENT_VERSION_LINK" ]] || jb_die "current version link is missing: $JB_CURRENT_VERSION_LINK"
  jb_current_root="$(/usr/bin/readlink "$JB_CURRENT_VERSION_LINK")"
  jb_validate_version_artifact "$jb_current_root"
  [[ -x "$JB_STABLE_BINARY" ]] || jb_die "installed binary is missing: $JB_STABLE_BINARY"
  [[ -f "$JB_PLIST" ]] || jb_die "LaunchAgent is missing: $JB_PLIST"
  jb_validate_plist_for_version "$jb_current_root" \
    || jb_die "LaunchAgent program does not match the current artifact schema: $JB_PLIST"
  jb_validate_process_ownership
}

jb_screen_capture_utility() {
  local jb_option="$1"
  local jb_current_root
  local jb_schema
  local jb_recorded_identity
  local jb_app

  jb_preflight_installed_service
  jb_current_root="$(/usr/bin/readlink "$JB_CURRENT_VERSION_LINK")"
  jb_schema="$(jb_artifact_schema "$jb_current_root")" \
    || jb_die "current version has an unknown artifact schema"
  [[ "$jb_schema" == "$JB_ARTIFACT_SCHEMA" ]] \
    || jb_die "screen-capture permission commands require an installed app-v2 artifact; run 'make install-service' first"

  jb_require_configured_signing_identity
  jb_recorded_identity="$(<"$jb_current_root/SIGNING_IDENTITY_SHA1")"
  [[ "$jb_recorded_identity" == "$JB_SIGNING_IDENTITY" ]] \
    || jb_die "current app was not signed by the configured identity"
  jb_app="$jb_current_root/$JB_APP_NAME"

  /usr/bin/open -W -n -g \
    -o /dev/stdout \
    --stderr /dev/stderr \
    "$jb_app" \
    --args "$jb_option"
}

jb_stop_service() {
  if jb_service_loaded; then
    /bin/launchctl bootout "$JB_SERVICE_TARGET" || return 1
    jb_wait_for_unloaded || return 1
  fi
}

jb_bootstrap_service() {
  if ! jb_wait_for_no_border_processes; then
    return 1
  fi
  if ! /bin/launchctl enable "$JB_SERVICE_TARGET"; then
    return 1
  fi
  if ! /bin/launchctl bootstrap "$JB_DOMAIN" "$JB_PLIST"; then
    return 1
  fi
  if ! jb_wait_for_running; then
    /bin/launchctl bootout "$JB_SERVICE_TARGET" >/dev/null 2>&1 || true
    jb_wait_for_unloaded
    return 1
  fi
}

jb_restart_service() {
  jb_preflight_installed_service
  jb_stop_service || return 1
  jb_wait_for_no_border_processes || return 1
  jb_bootstrap_service
}

jb_install() {
  local jb_old_current=""
  local jb_old_previous=""
  local jb_old_stable_binary=""
  local jb_old_stable_manpage=""
  local jb_new_schema

  /usr/bin/make -C "$JB_SOURCE_ROOT" all
  jb_require_no_homebrew_service
  jb_validate_version_link "$JB_CURRENT_VERSION_LINK"
  jb_validate_version_link "$JB_PREVIOUS_VERSION_LINK"
  jb_validate_managed_link "$JB_STABLE_BINARY" \
    "$JB_CURRENT_VERSION_LINK/bin/borders"
  jb_validate_managed_link "$JB_STABLE_MANPAGE" \
    "$JB_CURRENT_VERSION_LINK/share/man/man1/borders.1"
  jb_validate_managed_plist
  jb_validate_process_ownership

  if jb_service_loaded && [[ ! -L "$JB_CURRENT_VERSION_LINK" ]]; then
    jb_die "the service is loaded without a managed current-version link"
  fi
  if [[ -L "$JB_CURRENT_VERSION_LINK" ]]; then
    jb_old_current="$(/usr/bin/readlink "$JB_CURRENT_VERSION_LINK")"
    jb_validate_version_artifact "$jb_old_current"
  fi
  if [[ -L "$JB_PREVIOUS_VERSION_LINK" ]]; then
    jb_old_previous="$(/usr/bin/readlink "$JB_PREVIOUS_VERSION_LINK")"
  fi
  if [[ -L "$JB_STABLE_BINARY" ]]; then
    jb_old_stable_binary="$(/usr/bin/readlink "$JB_STABLE_BINARY")"
  fi
  if [[ -L "$JB_STABLE_MANPAGE" ]]; then
    jb_old_stable_manpage="$(/usr/bin/readlink "$JB_STABLE_MANPAGE")"
  fi
  jb_setup_signing
  jb_install_version
  jb_assert_designated_requirement_compatible "$JB_INSTALLED_VERSION_ROOT"
  jb_new_schema="$(jb_artifact_schema "$JB_INSTALLED_VERSION_ROOT")" \
    || jb_die "new version has an unknown artifact schema"
  jb_prepare_plist "$jb_new_schema" \
    || jb_die "LaunchAgent generation failed before the running service was stopped"
  jb_enter_critical_section
  jb_backup_plist

  if ! jb_stop_service || ! jb_wait_for_no_border_processes; then
    jb_discard_plist_backup || true
    if [[ -n "$jb_old_current" ]] && ! jb_service_loaded && ! jb_bootstrap_service; then
      jb_die "service stop failed; the previous installation was unchanged but its service could not restart"
    fi
    jb_die "service stop failed; the previous installation and service state were preserved"
  fi

  if ! jb_activate_version "$JB_INSTALLED_VERSION_ROOT" || ! jb_commit_prepared_plist; then
    jb_restore_install_state "$jb_old_current" "$jb_old_previous" "$jb_old_stable_binary" "$jb_old_stable_manpage" \
      || jb_die "activation failed after service stop and the previous installation state could not be restored"
    if [[ -n "$jb_old_current" ]] && jb_bootstrap_service; then
      jb_die "activation failed after service stop; the previous version was restored and is running"
    fi
    if [[ -n "$jb_old_current" ]]; then
      jb_die "activation failed after service stop; previous files were restored but the previous service could not restart"
    fi
    jb_die "first-install activation failed after service stop; managed installation state was removed"
  fi

  if ! jb_bootstrap_service; then
    if [[ -n "$jb_old_current" ]]; then
      jb_info "new version failed to start; restoring $jb_old_current"
      jb_restore_install_state "$jb_old_current" "$jb_old_previous" "$jb_old_stable_binary" "$jb_old_stable_manpage" \
        || jb_die "the new version failed and the previous installation state could not be restored"
      if jb_bootstrap_service; then
        jb_die "the new version failed to start; the previous version was restored and is running"
      fi
      jb_die "the new version and restored previous version both failed to start"
    fi

    jb_restore_install_state "$jb_old_current" "$jb_old_previous" "$jb_old_stable_binary" "$jb_old_stable_manpage" \
      || jb_die "the first version failed and managed installation state could not be cleaned up"
    jb_die "the first installed version failed to start; managed entry points were removed"
  fi

  jb_discard_plist_backup
  jb_leave_critical_section

  jb_info "installed version $JB_INSTALLED_VERSION"
  jb_info "binary: $JB_STABLE_BINARY -> $JB_INSTALLED_BINARY"
  jb_info "service: $JB_SERVICE_TARGET (running)"
  jb_info "logs: $JB_LOG_DIR"
}

jb_start() {
  jb_preflight_installed_service
  jb_enter_critical_section
  /bin/launchctl enable "$JB_SERVICE_TARGET" || jb_die "could not enable $JB_SERVICE_TARGET"

  if jb_service_loaded; then
    if ! /bin/launchctl kickstart -k "$JB_SERVICE_TARGET" || ! jb_wait_for_running; then
      /bin/launchctl bootout "$JB_SERVICE_TARGET" >/dev/null 2>&1 || true
      jb_wait_for_unloaded
      jb_die "LaunchAgent failed to remain running: $JB_SERVICE_TARGET"
    fi
  elif ! jb_bootstrap_service; then
    jb_die "LaunchAgent failed to remain running: $JB_SERVICE_TARGET"
  fi
  jb_leave_critical_section
  jb_info "service is running: $JB_SERVICE_TARGET"
}

jb_stop() {
  jb_validate_process_ownership
  jb_enter_critical_section
  /bin/launchctl disable "$JB_SERVICE_TARGET" || jb_die "could not disable $JB_SERVICE_TARGET"
  jb_stop_service || jb_die "the service was disabled but could not be unloaded"
  jb_leave_critical_section
  jb_info "service is stopped and disabled until service-start or install-service"
}

jb_rollback() {
  local jb_current
  local jb_previous
  local jb_previous_schema

  jb_preflight_installed_service
  [[ -L "$JB_PREVIOUS_VERSION_LINK" ]] || jb_die "no previous installed version is available"
  jb_current="$(/usr/bin/readlink "$JB_CURRENT_VERSION_LINK")"
  jb_previous="$(/usr/bin/readlink "$JB_PREVIOUS_VERSION_LINK")"
  jb_validate_version_artifact "$jb_previous"
  [[ "$jb_current" != "$jb_previous" ]] || jb_die "current and previous both point to $jb_current"
  jb_assert_designated_requirement_compatible "$jb_previous"
  jb_previous_schema="$(jb_artifact_schema "$jb_previous")" \
    || jb_die "rollback target has an unknown artifact schema: $jb_previous"
  jb_prepare_plist "$jb_previous_schema" \
    || jb_die "rollback LaunchAgent generation failed before the running service was stopped"

  jb_enter_critical_section
  jb_backup_plist

  if ! jb_stop_service || ! jb_wait_for_no_border_processes; then
    jb_discard_plist_backup || true
    if ! jb_service_loaded && ! jb_bootstrap_service; then
      jb_die "service stop failed; the installation was unchanged but the original service could not restart"
    fi
    jb_die "service stop failed; the original installation and service state were preserved"
  fi

  if ! jb_atomic_link "$jb_previous" "$JB_CURRENT_VERSION_LINK" \
    || ! jb_atomic_link "$jb_current" "$JB_PREVIOUS_VERSION_LINK" \
    || ! jb_commit_prepared_plist; then
    jb_restore_rollback_state "$jb_current" "$jb_previous" \
      || jb_die "rollback activation failed and the original installation state could not be restored"
    if jb_bootstrap_service; then
      jb_die "rollback activation failed; the original version was restored and is running"
    fi
    jb_die "rollback activation failed; original files were restored but the original service could not restart"
  fi

  if ! jb_bootstrap_service; then
    jb_info "rollback target failed to start; restoring $jb_current"
    jb_restore_rollback_state "$jb_current" "$jb_previous" \
      || jb_die "rollback target failed and the original installation state could not be restored"
    if jb_bootstrap_service; then
      jb_die "rollback failed; the original version was restored and is running"
    fi
    jb_die "rollback and recovery both failed to start"
  fi

  jb_discard_plist_backup
  jb_leave_critical_section
  jb_info "rolled back to $jb_previous"
  jb_info "service is running: $JB_SERVICE_TARGET"
}

jb_status() {
  local jb_target="not installed"
  local jb_current="not installed"
  local jb_previous="not available"
  local jb_schema="not available"
  local jb_program="not available"
  local jb_output
  local jb_pid

  if [[ -L "$JB_STABLE_BINARY" ]]; then
    jb_target="$(/usr/bin/readlink "$JB_STABLE_BINARY")"
  elif [[ -e "$JB_STABLE_BINARY" ]]; then
    jb_target="$JB_STABLE_BINARY (unmanaged)"
  fi
  if [[ -L "$JB_CURRENT_VERSION_LINK" ]]; then
    jb_current="$(/usr/bin/readlink "$JB_CURRENT_VERSION_LINK")"
    jb_schema="$(jb_artifact_schema "$jb_current" 2>/dev/null || printf unknown)"
  fi
  if [[ -L "$JB_PREVIOUS_VERSION_LINK" ]]; then
    jb_previous="$(/usr/bin/readlink "$JB_PREVIOUS_VERSION_LINK")"
  fi

  printf 'binary: %s -> %s\n' "$JB_STABLE_BINARY" "$jb_target"
  printf 'current: %s\n' "$jb_current"
  printf 'schema: %s\n' "$jb_schema"
  printf 'previous: %s\n' "$jb_previous"
  printf 'plist: %s\n' "$JB_PLIST"
  if [[ -f "$JB_PLIST" ]]; then
    jb_program="$(/usr/bin/plutil -extract ProgramArguments.0 raw -expect string "$JB_PLIST" 2>/dev/null || printf invalid)"
  fi
  printf 'program: %s\n' "$jb_program"
  printf 'signing configuration: %s\n' "$JB_SIGNING_IDENTITY_FILE"
  printf 'logs: %s\n' "$JB_LOG_DIR"

  if ! jb_output="$(/bin/launchctl print "$JB_SERVICE_TARGET" 2>&1)"; then
    printf 'service: not loaded (%s)\n' "$JB_SERVICE_TARGET"
    return 1
  fi

  printf '%s\n' "$jb_output" | /usr/bin/grep -E '^[[:space:]]*(state|path|program|pid|last exit code) =' || true
  jb_pid="$(printf '%s\n' "$jb_output" | /usr/bin/awk '/^[[:space:]]*pid = [0-9]+/ { print $3; exit }')"
  [[ "$jb_pid" =~ ^[0-9]+$ ]] && /bin/kill -0 "$jb_pid" 2>/dev/null
}

jb_uninstall() {
  jb_validate_version_link "$JB_CURRENT_VERSION_LINK"
  jb_validate_version_link "$JB_PREVIOUS_VERSION_LINK"
  jb_validate_managed_link "$JB_STABLE_BINARY" \
    "$JB_CURRENT_VERSION_LINK/bin/borders"
  jb_validate_managed_link "$JB_STABLE_MANPAGE" \
    "$JB_CURRENT_VERSION_LINK/share/man/man1/borders.1"
  jb_validate_managed_plist
  jb_validate_process_ownership
  jb_enter_critical_section
  /bin/launchctl disable "$JB_SERVICE_TARGET" || jb_die "could not disable $JB_SERVICE_TARGET"
  jb_stop_service || jb_die "the service was disabled but could not be unloaded"
  /bin/rm -f "$JB_PLIST"
  if [[ -L "$JB_STABLE_BINARY" ]]; then
    /bin/rm "$JB_STABLE_BINARY"
  fi
  if [[ -L "$JB_STABLE_MANPAGE" ]]; then
    /bin/rm "$JB_STABLE_MANPAGE"
  fi
  jb_leave_critical_section
  jb_info "removed the LaunchAgent and managed entry points"
  jb_info "versioned files remain available under $JB_INSTALL_ROOT"
}

jb_require_supported_environment
JB_ACTION="${1:-}"

case "$JB_ACTION" in
  install|start|stop|restart|rollback|uninstall|setup-signing|configure-signing|screen-capture-status|request-screen-capture)
    jb_acquire_lock
    ;;
esac

case "$JB_ACTION" in
  install)
    jb_install
    ;;
  start)
    jb_start
    ;;
  stop)
    jb_stop
    ;;
  restart)
    jb_enter_critical_section
    if ! jb_restart_service; then
      jb_die "LaunchAgent failed to remain running: $JB_SERVICE_TARGET"
    fi
    jb_leave_critical_section
    jb_info "service is running: $JB_SERVICE_TARGET"
    ;;
  rollback)
    jb_rollback
    ;;
  status)
    jb_status
    ;;
  uninstall)
    jb_uninstall
    ;;
  signing-help)
    jb_signing_help
    ;;
  setup-signing)
    jb_setup_signing
    ;;
  signing-status)
    jb_signing_status
    ;;
  configure-signing)
    jb_configure_signing
    ;;
  screen-capture-status)
    jb_screen_capture_utility --screen-capture-status
    ;;
  request-screen-capture)
    jb_screen_capture_utility --request-screen-capture
    ;;
  *)
    jb_usage >&2
    exit 2
    ;;
esac
